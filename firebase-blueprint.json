{
  "entities": {
    "BlogPost": {
      "title": "BlogPost",
      "description": "Article or blog post managed via Admin CMS",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "slug": { "type": "string" },
        "date": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "readTime": { "type": "string" },
        "excerpt": { "type": "string" },
        "image": { "type": "string" },
        "galleryImages": { "type": "array" },
        "imageAlt": { "type": "string" },
        "content": { "type": "string" },
        "contentFormat": { "type": "string" },
        "tags": { "type": "array" },
        "primaryKeywords": { "type": "array" },
        "secondaryKeywords": { "type": "array" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft", "scheduled", "ready_for_review"] },
        "author": { "type": "string" },
        "viewsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "category", "status", "content"]
    },
    "Project": {
      "title": "Project",
      "description": "Off-plan property project listing managed via Admin CMS",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "developer": { "type": "string" },
        "enclave": { "type": "string" },
        "priceAED": { "type": "number" },
        "priceUSD": { "type": "number" },
        "paymentPlan": { "type": "string" },
        "handover": { "type": "string" },
        "bedrooms": { "type": "string" },
        "type": { "type": "string" },
        "badge": { "type": "string" },
        "image": { "type": "string" },
        "coverImage": { "type": "string" },
        "heroImage": { "type": "string" },
        "area": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "roi": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft", "archived"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "developer", "priceAED", "status"]
    },
    "PlanningPage": {
      "title": "PlanningPage",
      "description": "Confidential internal planning notes, strategy and launch schedules",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "targetDate": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "content"]
    },
    "LandingPage": {
      "title": "LandingPage",
      "description": "Hidden promotional or investor campaign landing page managed via Admin",
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "badge": { "type": "string" },
        "tagline": { "type": "string" },
        "heroHeadline": { "type": "string" },
        "heroSubheadline": { "type": "string" },
        "heroImage": { "type": "string" },
        "developer": { "type": "string" },
        "location": { "type": "string" },
        "priceAED": { "type": "number" },
        "priceUSD": { "type": "number" },
        "paymentPlan": { "type": "string" },
        "handover": { "type": "string" },
        "roiEstimate": { "type": "string" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "ctaButtonText": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["slug", "title", "heroHeadline", "status"]
    },
    "LandingLead": {
      "title": "LandingLead",
      "description": "Investor inquiries generated via hidden landing pages",
      "type": "object",
      "properties": {
        "landingPageSlug": { "type": "string" },
        "landingPageTitle": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "budget": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["landingPageSlug", "name", "phone"]
    }
  },
  "firestore": {
    "/blogs/{blogId}": {
      "schema": { "$ref": "BlogPost" },
      "description": "Public and draft blog posts"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "Project" },
      "description": "Public and draft property development listings"
    },
    "/planning/{planId}": {
      "schema": { "$ref": "PlanningPage" },
      "description": "Confidential internal planning notes and roadmap items"
    },
    "/landing_pages/{landingPageId}": {
      "schema": { "$ref": "LandingPage" },
      "description": "Hidden campaign and investor landing pages"
    },
    "/landing_leads/{leadId}": {
      "schema": { "$ref": "LandingLead" },
      "description": "Inquiries received via hidden landing pages"
    }
  }
}
